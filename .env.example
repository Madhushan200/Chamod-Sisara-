# Supabase Public API Configuration (Optional: system runs with built-in instant storage fallback if not provided)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nodemailer / Hostinger SMTP Configuration
# (Can also be configured and tested via the in-app Settings page)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=reservations@dodozleisure.com
SMTP_PASS=your-hostinger-app-password
SMTP_FROM="Dodoz Leisure Reservations" <reservations@dodozleisure.com>
SMTP_SECURE=true

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
